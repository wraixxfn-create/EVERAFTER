; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; EVERAFTER — technical foundation (Prompt 01).
; Target engine: Godot 4.5 or newer stable (recommended: latest 4.x stable).
; `config/features` declares 4.5 so that older-than-latest 4.x editors still
; open the project without a version warning.

config_version=5

[application]

config/name="EVERAFTER"
config/description="Simulazione 3D di una civilta persistente e autonoma — villaggio esplorabile."
config/version="0.2.0-village"
run/main_scene="res://src/world/scenes/main_world.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/autoload/event_bus.gd"
Game="*res://src/core/autoload/game_root.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

